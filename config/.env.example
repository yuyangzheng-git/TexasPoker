# 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/poker_db

# Redis
REDIS_URL=redis://localhost:6379

# 服务器
PORT=8000
WS_PORT=8001
FRONTEND_URL=http://localhost:3000

# 游戏配置
MAX_CONCURRENT_LLM_CALLS=2
MONTE_CARLO_WORKERS=4

# Authentication (required in production; generate a private random value)
APP_ENV=development
JWT_SECRET_KEY=
# strategy runs locally without paid API calls; llm requires ANTHROPIC_API_KEY
POKER_AGENT_MODE=strategy

# LLM client used by the game and benchmark
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://cn.api.openai-next.com/

# Actual database setting used by the backend (defaults to backend/poker.db)
# SQLITE_DATABASE_URL=sqlite:////absolute/path/poker.db
